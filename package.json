{
  "name": "flaccompagnon",
  "private": true,
  "version": "0.9.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:site": "node scripts/build-site.mjs && node scripts/check-site.mjs",
    "preview:site": "vite preview --outDir dist-site --port 4174",
    "format:markdown": "prettier --write README.md AGENTS.md \"docs/**/*.md\"",
    "check:markdown": "prettier --check README.md AGENTS.md \"docs/**/*.md\"",
    "test:site": "node --test tests/site-markdown.test.mjs tests/site-seo.test.mjs",
    "test:search": "node --test tests/search.test.mjs",
    "test:table": "node --test tests/table-window.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "marked": "17.0.4",
    "prettier": "3.9.0",
    "richtypo": "^8.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3"
  }
}
